# Copy to .env (or point EW_ENV_FILES at your own files, comma-separated).
# Both KEY=value and KEY: value lines are accepted.
DISCORD_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=electionwatch
# Optional: register slash commands instantly in one test server instead of globally
DEV_GUILD_ID=
# Optional paid / keyed sources (adapter is skipped when its key is empty)
AP_API_KEY=
DDHQ_API_KEY=
# Adapter selection by registry name (see docs/). Scrapers of sites without an API are off
# by default; opt in here, e.g. EW_ENABLED_SOURCES=cbs,fox
EW_ENABLED_SOURCES=
EW_DISABLED_SOURCES=
# Optional (leave commented out unless you need them: an empty value is still a value)
# LOG_LEVEL=INFO
# Election the results adapters track (default 2026-11-03) and the default watch list file
# ELECTION_DATE=2026-11-03
# EW_RACES_FILE=config/races.yaml
# Per-adapter feed overrides (JSON), documented in each adapter's module docstring and
# docs/sources-results.md: CLARITY_FEEDS, ENHANCED_VOTING_FEEDS, MI_CLARITY_FEEDS,
# NJ_COUNTY_FEEDS, TX_COUNTY_FEEDS, IL_ELECTION_ID, MT_EID, SD_EID
