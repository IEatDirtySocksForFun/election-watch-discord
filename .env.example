# Copy this file to .env, or list your own comma-separated files in EW_ENV_FILES.
# Both KEY=value and KEY: value lines work.
DISCORD_TOKEN=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=electionwatch
# Optional: register slash commands instantly in one test server instead of globally
DEV_GUILD_ID=
# Optional paid / keyed sources (adapter is skipped when its key is empty)
AP_API_KEY=
DDHQ_API_KEY=
# Adapter selection by registry name (see docs/). Scrapers of sites without an API are off
# by default; opt in here, e.g. EW_ENABLED_SOURCES=cbs,fox
EW_ENABLED_SOURCES=
EW_DISABLED_SOURCES=
# Optional: limit an adapter to some states, "name=ST,ST;name2=ST". E.g. use the Fox national
# fallback only where no complete official feed exists (docs/state-coverage-plan.md):
# EW_SOURCE_STATES=fox_results=AL,KY,MA,ME,MI,MO,MS,NH,NJ,NV,NY,OK,TN,TX,WI,WY
# Optional (leave commented out unless you need them: an empty value is still a value)
# LOG_LEVEL=INFO
# Refresh rates and command limits (docs/customizing.md#refresh-rates-and-limits). Defaults
# are computed from each host's published rate limit; set these only to override.
# EW_RATE_SAFETY=2
# EW_RATE_LIMITS=civicapi.org=600/60
# EW_INTERVALS=odds=120,polls=1800
# EW_USER_COOLDOWN=120
# EW_USER_HOURLY=0
# EW_REFRESH_COOLDOWN=120
# EW_DEMAND_MAX=200
# EW_DEMAND_HOURS=24
# Election the results adapters track (default 2026-11-03) and the default watch list file
# ELECTION_DATE=2026-11-03
# EW_RACES_FILE=config/races.yaml
# Per-adapter feed overrides (JSON), documented in each adapter's module docstring and
# docs/sources-results.md: CLARITY_FEEDS, ENHANCED_VOTING_FEEDS, MI_CLARITY_FEEDS,
# NJ_COUNTY_FEEDS, TX_COUNTY_FEEDS, TN_COUNTY_FEEDS, IL_ELECTION_ID, MT_EID, SD_EID
